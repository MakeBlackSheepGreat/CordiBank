    </Box>
  </Box>

  <Box style={{ display: "flex", flexDirection: "row", gap: 14, marginTop: 18, borderTop: "1px solid #243044", paddingTop: 22 }}>
    <Box style={{ flex: 1 }}>
      <Text style={{ color: "#6B7280", fontSize: 12, letterSpacing: 2 }}>团队</Text>
      <Text style={{ color: "#D1D5DB", fontSize: 16, marginTop: 5 }}>CordiBank 蜂群项目组</Text>
    </Box>
