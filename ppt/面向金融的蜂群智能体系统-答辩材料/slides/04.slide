<Slide style={{ background: "#0B1220", padding: "44px 72px", display: "flex", flexDirection: "column" }}>
  <Text style={{ color: "#6B7280", fontSize: 14, letterSpacing: 3 }}>方案</Text>
  <Text style={{ color: "#F7F4EC", fontSize: 34, fontWeight: 700, marginTop: 10 }}>七个角色，各管一件事，结论汇到仲裁</Text>

  <Box style={{ display: "flex", flexDirection: "column", marginTop: 22, gap: 13 }}>
    <Box style={{ alignSelf: "center", background: "rgba(34,197,94,0.12)", border: "1px solid #22C55E", borderRadius: 10, padding: "17px 32px", display: "flex", flexDirection: "row", alignItems: "center", gap: 20 }}>
      <Text style={{ color: "#22C55E", fontSize: 20, fontWeight: 700 }}>意图官</Text>
      <Text style={{ color: "#D1D5DB", fontSize: 16 }}>听懂诉求，抽出工具与槽位，缺参数就问</Text>
    </Box>
    <Text style={{ color: "#4B5563", fontSize: 16, textAlign: "center" }}>↓ 派发</Text>
    <Box style={{ display: "flex", flexDirection: "row", gap: 20 }}>
      <Box style={{ flex: 1, background: "rgba(245,158,11,0.10)", border: "1px solid rgba(245,158,11,0.5)", borderRadius: 10, padding: "22px 20px" }}>
        <Text style={{ color: "#F59E0B", fontSize: 19, fontWeight: 700 }}>风控官</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.65, marginTop: 8 }}>按策略判风险，四维叠加，输出命中规则</Text>
      </Box>
      <Box style={{ flex: 1, background: "rgba(239,68,68,0.10)", border: "1px solid rgba(239,68,68,0.5)", borderRadius: 10, padding: "22px 20px" }}>
        <Text style={{ color: "#EF4444", fontSize: 19, fontWeight: 700 }}>合规官</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.65, marginTop: 8 }}>查收款人来源，查工具白名单，只做否决</Text>
      </Box>
      <Box style={{ flex: 1, background: "rgba(107,114,128,0.12)", border: "1px solid rgba(107,114,128,0.5)", borderRadius: 10, padding: "22px 20px" }}>
        <Text style={{ color: "#D1D5DB", fontSize: 19, fontWeight: 700 }}>体验官</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.65, marginTop: 8 }}>判断还缺什么，给替代路径，不参与风险</Text>
      </Box>
      <Box style={{ flex: 1, background: "rgba(34,197,94,0.06)", border: "1px solid rgba(34,197,94,0.32)", borderRadius: 10, padding: "22px 20px" }}>
        <Text style={{ color: "#22C55E", fontSize: 19, fontWeight: 700 }}>三路并行</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.65, marginTop: 8 }}>同时执行，任一失败只降级该维度，其余照常</Text>
      </Box>
    </Box>
    <Text style={{ color: "#4B5563", fontSize: 16, textAlign: "center" }}>↓ 三份结论并行汇入</Text>
    <Box style={{ alignSelf: "center", background: "rgba(59,130,246,0.12)", border: "1px solid #3B82F6", borderRadius: 10, padding: "17px 32px", display: "flex", flexDirection: "row", alignItems: "center", gap: 20 }}>
      <Text style={{ color: "#3B82F6", fontSize: 20, fontWeight: 700 }}>仲裁官</Text>
      <Text style={{ color: "#D1D5DB", fontSize: 16 }}>取最高风险，合并理由，任一否决即拦</Text>
    </Box>
    <Box style={{ display: "flex", flexDirection: "row", gap: 20, marginTop: 4 }}>
      <Box style={{ background: "rgba(34,197,94,0.10)", border: "1px solid rgba(34,197,94,0.5)", borderRadius: 10, padding: "16px 28px" }}>
        <Text style={{ color: "#22C55E", fontSize: 18, fontWeight: 700 }}>执行官　执行或签发令牌</Text>
      </Box>
      <Box style={{ background: "rgba(34,197,94,0.10)", border: "1px solid rgba(34,197,94,0.5)", borderRadius: 10, padding: "16px 28px" }}>
        <Text style={{ color: "#22C55E", fontSize: 18, fontWeight: 700 }}>审计官　写入哈希链</Text>
      </Box>
    </Box>

    <Box style={{ display: "flex", flexDirection: "row", gap: 20, marginTop: 18, borderTop: "1px solid #243044", paddingTop: 16 }}>
      <Box style={{ flex: 1, background: "rgba(59,130,246,0.07)", border: "1px solid rgba(59,130,246,0.3)", borderRadius: 10, padding: "14px 18px" }}>
        <Text style={{ color: "#93C5FD", fontSize: 16, fontWeight: 700 }}>模型只在一环出现</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.6, marginTop: 5 }}>模型只在意图官解析诉求与选工具，风险判定与执行全在代码层。</Text>
      </Box>
      <Box style={{ flex: 1, background: "rgba(107,114,128,0.10)", border: "1px solid rgba(107,114,128,0.3)", borderRadius: 10, padding: "14px 18px" }}>
        <Text style={{ color: "#D1D5DB", fontSize: 16, fontWeight: 700 }}>每个角色留痕</Text>
        <Text style={{ color: "#9CA3AF", fontSize: 15, lineHeight: 1.6, marginTop: 5 }}>七个角色的结论与耗时都进审计，界面上可逐条展开核对。</Text>
      </Box>
    </Box>
  </Box>
</Slide>
